# === Telegram API credentials ===
# หาได้จาก https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# === Bot Token ===
# หาได้จาก @BotFather
BOT_TOKEN=your_bot_token_here

# === Destination Group ===
# Group ID ปลายทาง (ต้องเป็น supergroup ที่เปิด Topics ไว้)
DEST_GROUP_ID=-1001234567890

# === Access Control ===
# Telegram user_id ที่อนุญาตให้ใช้คำสั่ง clone (คั่นด้วย comma)
ALLOWED_USER_IDS=111111111,222222222

# === Download settings ===
DOWNLOAD_DIR=./downloads
# หน่วงเวลาระหว่างส่งแต่ละไฟล์ (วินาที) เพื่อหลีกเลี่ยง flood wait
SEND_DELAY=1.5
